<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#202020"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- App icon -->
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/opencpn_mobile"
        android:contentDescription="OpenCPN"/>

    <!-- App title -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OpenCPN"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"/>

    <!-- Flexible spacer pushes buttons right -->
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>

    <!-- Quick action buttons -->

    <ImageButton
        android:id="@+id/btn_follow"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/follow"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="Follow"/>

    <ImageButton
        android:id="@+id/btn_rmd"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/route_manager"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="Route Manager"/>

    <ImageButton
        android:id="@+id/btn_track"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/trackoff"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="Track"/>

    <ImageButton
        android:id="@+id/btn_route"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/route"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="Route"/>

    <!-- Overflow button -->

    <ImageButton
        android:id="@+id/btn_overflow"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_more_vert"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="More"/>

</LinearLayout>